# Copy this file to `.env.local` and fill in your own Supabase project to run
# Padosi AI against a real, shared, persistent backend.
#
# Leave both values empty/unset to run in Local Demo Mode instead: the app
# will then use an in-browser backend (localStorage + BroadcastChannel) that
# implements the exact same interface, so every page works out of the box
# with zero configuration — this is what ships by default in this prototype.

VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Never put your Supabase *service role* key here or in any client file —
# only the public anon key belongs in the browser. Authorization is enforced
# by the Row Level Security policies in supabase/migrations/0001_schema.sql.
